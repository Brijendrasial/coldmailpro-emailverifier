# App
PORT=3001

# ping-email / SMTP identity
PING_EMAIL_PORT=25
PING_EMAIL_FQDN=mail.yourdomain.com
PING_EMAIL_SENDER=verify@yourdomain.com
PING_EMAIL_TIMEOUT=10000
PING_EMAIL_ATTEMPTS=2
PING_EMAIL_IGNORE_SMTP=false

# Catch-all intelligence
CATCH_ALL_ENABLED=true
CATCH_ALL_TESTS=2

# Bulk verification
BULK_MAX_EMAILS=10000
BULK_DELAY_MS=150
WORKER_CONCURRENCY=2

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=email_verifier
DB_USER=email_verifier
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_POOL_SIZE=10

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Email Finder direct SMTP pacing between candidate RCPT checks
FINDER_SMTP_DELAY_MS=300

# v4 SMTP transcript/TLS diagnostics
SMTP_DIAGNOSTICS_ENABLED=true
SMTP_STARTTLS=true

# Domain monitoring worker checks due domains once per minute.
# Per-domain interval is configured from the GUI (minimum 15 minutes).

# Automatic temporary SMTP retry scheduler
GREYLIST_RETRY_MINUTES=5,30,120
GREYLIST_MAX_RETRIES=3
